{
  "product": {
    "id": "com.cambric.c_around",
    "name": "C Around",
    "subtitle": "The world, explained.",
    "description": "An offline accessibility companion that describes objects, reads text, names people, monitors sounds and keeps your emergency information one tap away — no internet required.",
    "publisher": "Cambric Software",
    "version": "1.0.9",
    "templateVersion": "1.0.0",
    "website": "https://cambric-software.github.io/c-around/",
    "supportUrl": "https://github.com/Cambric-software/c-around/issues"
  },
  "release": {
    "provider": "github",
    "repository": "Cambric-software/c-around",
    "apiBase": "https://api.github.com"
  },
  "cache": {
    "version": 1,
    "maxBytes": 524288000
  },
  "update": {
    "enabled": true,
    "automaticChecks": true,
    "allowPrerelease": false
  },
  "ecosystem": {
    "enabled": true,
    "protocolVersion": 1
  },
  "subscription": {
    "enabled": false,
    "provider": "none",
    "tiers": ["free", "pro"],
    "defaultTier": "free",
    "licenseValidation": "offline-hmac",
    "updateGating": {
      "free": "stable",
      "pro": "stable,prerelease"
    }
  },
  "localization": {
    "defaultLanguage": "en",
    "supportedLanguages": ["en", "ar", "fr", "de"],
    "rtlLanguages": ["ar"]
  },
  "environment": "production",
  "featureFlags": {
    "showDeveloperTools": false,
    "enableExperimentalCache": false
  },
  "branding": {
    "primaryColor": "",
    "secondaryColor": ""
  },
  "security": {
    "requireIntegrityCheck": true,
    "redactLogsInProduction": true
  },
  "diagnostics": {
    "enabled": true,
    "logLevel": "info",
    "maxLogFileSizeBytes": 5242880,
    "maxLogFiles": 5
  }
}
